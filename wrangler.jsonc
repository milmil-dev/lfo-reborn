// Cloudflare Workers static assets: the SPA build plus the game's assets
// (copied into web/dist/assets by CI, see deploy/README.md). There is no Worker
// script, so every request is a static asset request: free and unmetered.
{
	"$schema": "https://unpkg.com/wrangler@4/config-schema.json",
	"name": "lfo-reborn",
	"compatibility_date": "2026-09-30",
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"directory": "./web/dist",
		// Client-side routes (/play/lobby …) get index.html instead of a 404.
		"not_found_handling": "single-page-application"
	}
}
