{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  // worker-configuration.d.ts is what `wrangler types` writes (the runtime's types + the bindings)
  "include": [
    "src",
    "worker-configuration.d.ts",
    "../web/src/game/net/protocol.ts",
    "../web/src/game/core/types.ts"
  ]
}
